{
    "layer": "top",
    "position": "bottom",
    "margin-top": 8,
    "margin-bottom": 4,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 0,
    "modules-left": [
        "custom/launcher",
        "sway/workspaces",
        "custom/separator",
        "sway/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "sway/language",
        "custom/separator",
        "cpu",
        "memory",
        "custom/separator",
        "pulseaudio",
        "network",
        "battery",
        "custom/power"
    ],
    "custom/launcher": {
        "format": "󰣇",
        "on-click": "rofi -show drun",
        "tooltip": false
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}"
    },
    "sway/window": {
        "format": "󱂬 {title}",
        "max-length": 20,
        "empty-text": "~"
    },
    "clock": {
        "interval": 1,
        "format": "󰥔 {:%H:%M  │  󰃭 %d.%m.%Y}",
        "tooltip": false,
        "timezone": "Europe/Kyiv"
    },
    "sway/language": {
        "format": "󰌌 {short}",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },
    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2
    },
    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 2
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Mute",
        "format-icons": {
            "headphone": "󰋋",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol"
    },
    "network": {
        "format-wifi": "󰖩 {essid}",
        "format-ethernet": "󰈀 Ethernet",
        "format-disconnected": "󰖪 Offline",
        "on-click": "kitty nmtui"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁼",
            "󰁽",
            "󰁿",
            "󰂁",
            "󰁹"
        ]
    },
    "custom/separator": {
        "format": "│",
        "interval": "once",
        "tooltip": false
    },
    "custom/power": {
        "format": "󰐥",
        "on-click": "wlogout || rofi -show power-menu",
        "tooltip": false
    }
}