* {
    bg-col:                      rgba(18, 18, 24, 0.90);
    border-col:                  rgba(255, 255, 255, 0.10);
    selected-col:                rgba(255, 255, 255, 0.15);
    fg-col:                      #ffffff;
    fg-alt:                      rgba(255, 255, 255, 0.60);
    
    background-color:            transparent;
    text-color:                  @fg-col;
    margin:                      0px;
    padding:                     0px;
    spacing:                     0px;
}

window {
    location:                    north west;
    anchor:                      north west;
    y-offset:                    38px; /* Вплотную к плашке Waybar */
    x-offset:                    12px; 
    
    width:                       280px; 
    border:                      1px;
    border-color:                @border-col;
    border-radius:               12px;
    background-color:            @bg-col;
}

mainbox {
    enabled:                     true;
    padding:                     10px;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    enabled:                     true;
    background-color:            rgba(255, 255, 255, 0.03);
    border:                      1px;
    border-color:                rgba(255, 255, 255, 0.06);
    border-radius:               8px;
    padding:                     6px 10px;
    margin:                      0px 0px 8px 0px;
    children:                    [ "entry" ]; /* Без prompt */
}

entry {
    enabled:                     true;
    text-color:                  @fg-col;
    placeholder:                 "Поиск...";
    placeholder-color:           @fg-alt;
}

listview {
    enabled:                     true;
    columns:                     1;
    lines:                       6;
    cycle:                       true;
    scrollbar:                   false;
    layout:                      vertical;
    fixed-height:                true;
    spacing:                     2px;
}

element {
    enabled:                     true;
    padding:                     6px 10px;
    border-radius:               6px;
    background-color:            transparent;
    text-color:                  @fg-col;
    cursor:                      pointer;
}

element selected.normal {
    background-color:            @selected-col;
    text-color:                  @fg-col;
}

element-icon {
    size:                        20px;
    margin:                      0px 8px 0px 0px;
}

element-text {
    vertical-align:              0.5;
}
