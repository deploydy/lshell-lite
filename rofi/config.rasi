configuration {
    modi: "drun,run,window,filebrowser";
    show-icons: true;
    icon-theme: "Papirus-Dark";

    display-drun: "Apps";
    display-run: "Commands";
    display-window: "Windows";
    display-filebrowser: "Files";

    drun-display-format: "{name} <span alpha='50%' size='small'>{generic}</span>";
    window-format: "{c}  {t}";

    matching: "fuzzy";
    sorting-method: "fzf";
    sort: true;
    case-sensitive: false;

    cycle: true;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    kb-mode-next: "Control+Tab,Shift+Right";
    kb-mode-previous: "Control+Shift+Tab,Shift+Left";
}

* {
    bg:        #1c1c1ee3;
    line:      #ffffff1f;
    frame:     #ffffffb8;
    fg:        #f5f5f7;
    fg-dim:    #a1a1a6;
    accent:    #0a7aff;

    font: "Inter 11";
    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: north;
    anchor: north;
    y-offset: 22%;
    width: 410px;
    background-color: @bg;
    border: 1px;
    border-color: @frame;
    border-radius: 17px;
}

mainbox {
    spacing: 0;
    children: [ inputbar, listview, mode-switcher ];
}

inputbar {
    padding: 12px 16px;
    spacing: 10px;
    border: 0 0 1px 0;
    border-color: @line;
    children: [ icon-search, entry ];
}

icon-search {
    expand: false;
    filename: "system-search-symbolic";
    size: 19px;
    vertical-align: 0.5;
}

entry {
    expand: true;
    font: "Inter 14";
    placeholder: "Lshell Search";
    placeholder-color: @fg-dim;
    text-color: @fg;
    cursor-color: @accent;
    vertical-align: 0.5;
}

listview {
    lines: 5;
    columns: 1;
    dynamic: true;
    fixed-height: false;
    scrollbar: false;
    padding: 6px;
    spacing: 2px;
}

element {
    padding: 6px 10px;
    spacing: 10px;
    border-radius: 9px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @accent;
    text-color: #ffffff;
}

element-icon {
    size: 24px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    markup: true;
    highlight: bold #a1a1a6;
}

element-text selected.normal {
    highlight: bold #ffffffb3;
}

mode-switcher {
    padding: 5px 6px;
    spacing: 4px;
    border: 1px 0 0 0;
    border-color: @line;
}

button {
    padding: 5px 7px;
    font: "Inter Medium 10";
    background-color: transparent;
    border-radius: 8px;
    text-color: @fg-dim;
    horizontal-align: 0.5;
}

button selected {
    background-color: #ffffff26;
    text-color: #ffffff;
}
